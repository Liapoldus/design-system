{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Liapoldus Design System",
  "version": "1.0.0",
  "color": {
    "orange": { "$value": "#FF641C", "$type": "color" },
    "apricot": { "$value": "#FFD4A3", "$type": "color" },
    "forest": { "$value": "#1F3A32", "$type": "color" },
    "mint": { "$value": "#E3F0E7", "$type": "color" },
    "paper": { "$value": "#FAF9F5", "$type": "color" },
    "ink": { "$value": "#0F1A17", "$type": "color" },
    "accentInk": { "$value": "#A63B0B", "$type": "color" }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
