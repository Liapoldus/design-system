{
  "name": "@liapoldus/design-system",
  "version": "1.0.0",
  "description": "Brand assets, design tokens and iconography for the Liapoldus ecosystem.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liapoldus/design-system.git"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "build:native-icons": "node scripts/build-native-icons.mjs",
    "build:mascots": "node scripts/build-mascot-pngs.mjs",
    "build:package": "node scripts/build-package-assets.mjs",
    "build:assets": "npm run build:native-icons && npm run build:mascots && npm run build:package",
    "check:svg": "python3 scripts/validate-svg.py --render && npm run build:package && python3 scripts/validate-svg.py --package --render"
  },
  "files": [
    "dist/logo/",
    "dist/icons/",
    "dist/mascots/",
    "dist/fonts/",
    "tokens/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./logo/*": "./dist/logo/*",
    "./icons/*": "./dist/icons/*",
    "./mascots/*": "./dist/mascots/*",
    "./fonts.css": "./dist/fonts/fonts.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "devDependencies": {
    "svgo": "4.1.0"
  }
}
